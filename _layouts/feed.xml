{%- comment -%}
RSS 2.0. Without `topic`: every news item and letter (/feed.xml). With `topic`: that topic's news
(/news/<key>/feed.xml, generated by _plugins/news.rb).
{%- endcomment -%}
{%- if page.topic -%}
  {%- assign topic = site.data.topics | where: "key", page.topic | first -%}
  {%- assign items = site.news | where_exp: "item", "item.topics contains page.topic" -%}
  {%- capture title %}{{ topic.label }} news - {{ site.data.settings.title }}{% endcapture -%}
  {%- capture link %}/news/{{ page.topic }}/{% endcapture -%}
{%- else -%}
  {%- assign items = site.news | concat: site.letters -%}
  {%- assign title = site.data.settings.title -%}
  {%- assign link = "/news" -%}
{%- endif -%}
{%- assign items = items | sort: "date" | reverse -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ title | xml_escape }}</title>
    <description>{{ site.data.settings.description | xml_escape }}</description>
    <link>{{ link | absolute_url }}</link>
    <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml"/>
    <language>es</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <generator>Jekyll v{{ jekyll.version }}</generator>
    {%- for item in items limit: 20 %}
    <item>
      <title>{{ item.title | xml_escape }}</title>
      <description>{{ item.content | xml_escape }}</description>
      <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
      <link>{{ item.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ item.url | absolute_url }}</guid>
      {%- for key in item.topics %}
      <category>{{ key }}</category>
      {%- endfor %}
    </item>
    {%- endfor %}
  </channel>
</rss>
